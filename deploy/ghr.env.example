# Configuration for the release inbox. Install as /etc/ghr/ghr.env (owner root:ghr, mode 0640).
# Use single quotes for values that contain "$" (the password hash does).

# Classic personal access token with the "notifications" and "repo" scopes.
# Create it at https://github.com/settings/tokens (fine-grained tokens can't read notifications).
GHR_GITHUB_TOKEN=

# Sign-in for the web app. Create the hash with: ghr hash-password
GHR_USERNAME=
GHR_PASSWORD_HASH=''

# Signs the session cookie. Create it with: ghr generate-secret
GHR_SESSION_SECRET=
GHR_SESSION_MAX_AGE_DAYS=30

GHR_DATABASE_PATH=/var/lib/ghr/ghr.db

# Push notifications. Create the key pair with: ghr generate-vapid-keys
GHR_VAPID_PUBLIC_KEY=
GHR_VAPID_PRIVATE_KEY=
GHR_VAPID_SUBJECT=mailto:you@example.com
