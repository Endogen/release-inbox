[Unit]
Description=Back up the release inbox database
After=ghr.service

[Service]
Type=oneshot
User=ghr
Group=ghr
WorkingDirectory=/opt/ghr/backend
EnvironmentFile=/etc/ghr/ghr.env
ExecStart=/opt/ghr/backend/.venv/bin/ghr backup /var/backups/ghr --keep 14

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ghr /var/backups/ghr
