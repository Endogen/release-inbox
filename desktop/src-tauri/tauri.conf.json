{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Releases",
  "identifier": "io.github.endogen.releaseinbox",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Endogen",
    "category": "DeveloperTool",
    "shortDescription": "Your GitHub release inbox",
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
